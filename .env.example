# App
APP_NAME=closet-muse
BACKEND_URL=http://localhost:8000
DEBUG=true

# OpenRouter (image generation)
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_IMAGE_URL=https://openrouter.ai/api/v1/images
IMAGE_TIMEOUT=180

# Image models, one per purpose. Each has its own default; set only the ones you
# want to change.
IMAGE_MODEL_POLISH=meta/muse-image                    # onboarding: dress a mannequin
IMAGE_MODEL_TRYON=meta/muse-image                     # outfit generator: dress the model
IMAGE_MODEL_MANNEQUIN=openai/gpt-image-2.5-sunburst   # scripts/generate_mannequins.py
IMAGE_MODEL_FASHION_MODEL=meta/muse-image             # scripts/generate_model.py
IMAGE_ASPECT_RATIO=2:3
IMAGE_SEED=42

# Clothing-attribute extraction (local Ollama vision model)
ATTRIBUTE_MODEL=qwen3-vl:4b
# OLLAMA_HOST=http://localhost:11434

# Local database (SQLite)
SQLITE_PATH=var/closet_muse.db

# Local image storage
STORAGE_DIR=var/storage
STORAGE_BUCKET_CLOTHING=clothing
STORAGE_BUCKET_AVATAR=avatar
STORAGE_BUCKET_GENERATED=generated
